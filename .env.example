# Luna Genjutsu settings. Copy to .env (setup does this) and fill in your own keys.
# Never commit or share a filled .env.

# enhancor | byteplus | mock (mock = free dry run of the whole pipeline)
PROVIDER=enhancor

# Seedance via Enhancor (allows your own face in references): https://app.enhancor.ai/api-dashboard
ENHANCOR_API_KEY=
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1

# Official BytePlus ModelArk (rejects real faces unless they are in your private portrait library)
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_MODEL=dreamina-seedance-2-0-260128

# Replicate: SAM 3 masks + video depth + Demucs voice separation (best quality, a few cents per clip)
# Without it masking runs locally with MediaPipe (pip install -r requirements-local.txt).
REPLICATE_API_TOKEN=

# How the provider downloads your files:
#   tunnel    – temporary Cloudflare Quick Tunnel to a files-only port (private, default)
#   tmpfiles  – tmpfiles.org (public link, ~1 hour)
#   litterbox – litterbox.catbox.moe (public link, 24 hours)
MEDIA_HOST=tunnel
# Your own HTTPS tunnel to PUBLIC_PORT instead of cloudflared (optional)
PUBLIC_BASE_URL=

PORT=8770
PUBLIC_PORT=8771
